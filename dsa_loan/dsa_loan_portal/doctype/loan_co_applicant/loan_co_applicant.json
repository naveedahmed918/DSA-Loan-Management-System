{
  "doctype": "DocType",
  "name": "Loan Co-applicant",
  "module": "DSA Loan Portal",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "is_submittable": 0,
  "autoname": "naming_series:",
  "engine": "InnoDB",
  "track_changes": 1,
  "allow_import": 1,
  "allow_rename": 0,
  "field_order": [
    "naming_series",
    "customer_loan_application",
    "co_applicant_name",
    "relationship",
    "mobile_number",
    "email",
    "date_of_birth",
    "pan_number",
    "employment_type",
    "employer_business_name",
    "monthly_income",
    "address",
    "is_primary_co_applicant"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "COAPP-.YYYY.-.#####",
      "in_list_view": 1
    },
    {
      "fieldname": "customer_loan_application",
      "label": "Customer Loan Application",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "Customer Loan Application",
      "in_list_view": 1
    },
    {
      "fieldname": "co_applicant_name",
      "label": "Co-applicant Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "relationship",
      "label": "Relationship",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "Spouse\nParent\nChild\nSibling\nOther",
      "in_list_view": 1
    },
    {
      "fieldname": "mobile_number",
      "label": "Mobile Number",
      "fieldtype": "Data",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Data",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "date_of_birth",
      "label": "Date of Birth",
      "fieldtype": "Date",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "pan_number",
      "label": "PAN Number",
      "fieldtype": "Data",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "employment_type",
      "label": "Employment Type",
      "fieldtype": "Select",
      "reqd": 0,
      "options": "Salaried\nSelf Employed\nBusiness Owner\nOther",
      "in_list_view": 1
    },
    {
      "fieldname": "employer_business_name",
      "label": "Employer / Business Name",
      "fieldtype": "Data",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "monthly_income",
      "label": "Monthly Income",
      "fieldtype": "Currency",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "address",
      "label": "Address",
      "fieldtype": "Small Text",
      "reqd": 0
    },
    {
      "fieldname": "is_primary_co_applicant",
      "label": "Primary Co-applicant",
      "fieldtype": "Check",
      "reqd": 0
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    }
  ]
}
