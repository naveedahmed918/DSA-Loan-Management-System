{
  "doctype": "DocType",
  "name": "Lender Scheme Rate Card",
  "module": "DSA Loan Portal",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "is_submittable": 0,
  "autoname": "naming_series:",
