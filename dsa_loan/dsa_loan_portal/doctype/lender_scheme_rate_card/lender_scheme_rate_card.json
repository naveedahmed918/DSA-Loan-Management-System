      "fieldtype": "Select",
      "reqd": 1,
      "options": "Draft\nActive\nInactive\nExpired",
      "in_list_view": 1
    },
    {
      "fieldname": "terms_and_conditions",
      "label": "Terms and Conditions",
      "fieldtype": "Text",
      "reqd": 0
