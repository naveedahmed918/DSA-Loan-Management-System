    {
      "fieldname": "effective_from",
      "label": "Effective From",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "effective_to",
      "label": "Effective To",
      "fieldtype": "Date",
      "reqd": 0,
      "in_list_view": 1
    },
    {
