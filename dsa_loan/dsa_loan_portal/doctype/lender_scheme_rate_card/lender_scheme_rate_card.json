      "in_list_view": 1
    },
    {
      "fieldname": "loan_product",
      "label": "Loan Product",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "Lender Loan Product",
      "in_list_view": 1
    },
    {
      "fieldname": "scheme_code",
      "label": "Scheme Code",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "scheme_name",
      "label": "Scheme Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
