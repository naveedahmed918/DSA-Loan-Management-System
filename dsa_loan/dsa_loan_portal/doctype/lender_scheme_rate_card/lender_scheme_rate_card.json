      "fieldtype": "Percent",
      "reqd": 0
    },
    {
      "fieldname": "minimum_tenure_months",
      "label": "Minimum Tenure (Months)",
      "fieldtype": "Int",
      "reqd": 0
    },
    {
      "fieldname": "maximum_tenure_months",
      "label": "Maximum Tenure (Months)",
      "fieldtype": "Int",
      "reqd": 0
    },
    {
      "fieldname": "processing_fee",
      "label": "Processing Fee",
      "fieldtype": "Currency",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "processing_fee_percentage",
      "label": "Processing Fee Percentage",
      "fieldtype": "Percent",
      "reqd": 0
