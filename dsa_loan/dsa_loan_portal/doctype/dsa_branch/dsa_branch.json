{
  "doctype": "DocType",
  "name": "DSA Branch",
  "module": "DSA Loan Portal",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "is_submittable": 0,
  "autoname": "naming_series:",
  "engine": "InnoDB",
  "track_changes": 1,
  "allow_import": 1,
  "allow_rename": 0,
  "field_order": [
    "naming_series",
    "branch_name",
    "branch_code",
    "parent_branch",
    "branch_manager",
    "contact_person",
    "email",
    "phone",
    "address",
    "city",
    "state",
    "pincode",
    "branch_status"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "DSAB-.YYYY.-.#####",
      "in_list_view": 1
    },
    {
      "fieldname": "branch_name",
      "label": "Branch Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "branch_code",
      "label": "Branch Code",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "parent_branch",
      "label": "Parent Branch",
      "fieldtype": "Link",
      "reqd": 0,
      "options": "DSA Branch",
      "in_list_view": 1
    },
    {
      "fieldname": "branch_manager",
      "label": "Branch Manager",
      "fieldtype": "Link",
      "reqd": 0,
      "options": "User",
      "in_list_view": 1
    },
    {
      "fieldname": "contact_person",
      "label": "Contact Person",
      "fieldtype": "Data",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Data",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "phone",
      "label": "Phone",
      "fieldtype": "Data",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "address",
      "label": "Address",
      "fieldtype": "Small Text",
      "reqd": 0
    },
    {
      "fieldname": "city",
      "label": "City",
      "fieldtype": "Data",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "state",
      "label": "State",
      "fieldtype": "Data",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "pincode",
      "label": "PIN Code",
      "fieldtype": "Data",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "branch_status",
      "label": "Branch Status",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "Active\nInactive\nSuspended",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    }
  ]
}
