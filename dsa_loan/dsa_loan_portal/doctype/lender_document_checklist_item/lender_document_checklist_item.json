{
  "doctype": "DocType",
  "name": "Lender Document Checklist Item",
  "module": "DSA Loan Portal",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "is_submittable": 0,
  "autoname": "naming_series:",
  "engine": "InnoDB",
  "track_changes": 1,
  "allow_import": 1,
  "allow_rename": 0,
  "field_order": [
    "naming_series",
    "lender_application",
    "document_rule",
    "document_name",
    "applicant_type",
    "is_mandatory",
    "checklist_status",
    "verified_by",
    "verification_date",
    "remarks"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "LDCI-.YYYY.-.#####",
      "in_list_view": 1
    },
    {
      "fieldname": "lender_application",
      "label": "Lender Application",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "Lender Application",
      "in_list_view": 1
    },
    {
      "fieldname": "document_rule",
      "label": "Document Rule",
      "fieldtype": "Link",
      "reqd": 0,
      "options": "Lender Document Rule",
      "in_list_view": 1
    },
    {
      "fieldname": "document_name",
      "label": "Document Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "applicant_type",
      "label": "Applicant Type",
      "fieldtype": "Select",
      "reqd": 0,
      "options": "Applicant\nCo-applicant\nGuarantor\nProperty",
      "in_list_view": 1
    },
    {
      "fieldname": "is_mandatory",
      "label": "Mandatory",
      "fieldtype": "Check",
      "reqd": 0
    },
    {
      "fieldname": "checklist_status",
      "label": "Checklist Status",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "Pending\nUploaded\nVerified\nRejected\nWaived",
      "in_list_view": 1
    },
    {
      "fieldname": "verified_by",
      "label": "Verified By",
      "fieldtype": "Link",
      "reqd": 0,
      "options": "User",
      "in_list_view": 1
    },
    {
      "fieldname": "verification_date",
      "label": "Verification Date",
      "fieldtype": "Date",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Small Text",
      "reqd": 0
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    }
  ]
}
