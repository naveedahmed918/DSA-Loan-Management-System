{
  "doctype": "DocType",
  "name": "Loan Sanction Condition",
  "module": "DSA Loan Portal",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "is_submittable": 0,
  "autoname": "naming_series:",
  "engine": "InnoDB",
  "track_changes": 1,
  "allow_import": 1,
  "allow_rename": 0,
  "field_order": [
    "naming_series",
    "lender_application",
    "condition_title",
    "condition_description",
    "condition_type",
    "due_date",
    "condition_status",
    "verified_by",
    "verified_on",
    "remarks"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "LSC-.YYYY.-.#####",
      "in_list_view": 1
    },
    {
      "fieldname": "lender_application",
      "label": "Lender Application",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "Lender Application",
      "in_list_view": 1
    },
    {
      "fieldname": "condition_title",
      "label": "Condition Title",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "condition_description",
      "label": "Condition Description",
      "fieldtype": "Text",
      "reqd": 0
    },
    {
      "fieldname": "condition_type",
      "label": "Condition Type",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "Pre-disbursement\nPost-disbursement\nOther",
      "in_list_view": 1
    },
    {
      "fieldname": "due_date",
      "label": "Due Date",
      "fieldtype": "Date",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "condition_status",
      "label": "Condition Status",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "Pending\nSubmitted\nVerified\nWaived\nRejected",
      "in_list_view": 1
    },
    {
      "fieldname": "verified_by",
      "label": "Verified By",
      "fieldtype": "Link",
      "reqd": 0,
      "options": "User",
      "in_list_view": 1
    },
    {
      "fieldname": "verified_on",
      "label": "Verified On",
      "fieldtype": "Datetime",
      "reqd": 0
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Small Text",
      "reqd": 0
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    }
  ]
}
