{
  "doctype": "DocType",
  "name": "Lender Application Document",
  "module": "DSA Loan Portal",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "is_submittable": 0,
  "autoname": "naming_series:",
  "engine": "InnoDB",
  "track_changes": 1,
  "allow_import": 1,
  "allow_rename": 0,
  "field_order": [
    "naming_series",
    "lender_application",
    "checklist_item",
    "document_name",
    "document_type",
    "attachment",
    "uploaded_by",
    "uploaded_on",
    "verification_status",
    "verified_by",
    "verified_on",
    "rejection_reason"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "LAD-.YYYY.-.#####",
      "in_list_view": 1
    },
    {
      "fieldname": "lender_application",
      "label": "Lender Application",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "Lender Application",
      "in_list_view": 1
    },
    {
      "fieldname": "checklist_item",
      "label": "Checklist Item",
      "fieldtype": "Link",
      "reqd": 0,
      "options": "Lender Document Checklist Item",
      "in_list_view": 1
    },
    {
      "fieldname": "document_name",
      "label": "Document Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "document_type",
      "label": "Document Type",
      "fieldtype": "Select",
      "reqd": 0,
      "options": "Identity\nAddress\nIncome\nBank Statement\nProperty\nBusiness\nOther",
      "in_list_view": 1
    },
    {
      "fieldname": "attachment",
      "label": "Attachment",
      "fieldtype": "Attach",
      "reqd": 1
    },
    {
      "fieldname": "uploaded_by",
      "label": "Uploaded By",
      "fieldtype": "Link",
      "reqd": 0,
      "options": "User",
      "in_list_view": 1
    },
    {
      "fieldname": "uploaded_on",
      "label": "Uploaded On",
      "fieldtype": "Datetime",
      "reqd": 0
    },
    {
      "fieldname": "verification_status",
      "label": "Verification Status",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "Pending\nVerified\nRejected",
      "in_list_view": 1
    },
    {
      "fieldname": "verified_by",
      "label": "Verified By",
      "fieldtype": "Link",
      "reqd": 0,
      "options": "User",
      "in_list_view": 1
    },
    {
      "fieldname": "verified_on",
      "label": "Verified On",
      "fieldtype": "Datetime",
      "reqd": 0
    },
    {
      "fieldname": "rejection_reason",
      "label": "Rejection Reason",
      "fieldtype": "Small Text",
      "reqd": 0
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    }
  ]
}
