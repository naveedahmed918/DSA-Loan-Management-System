{
  "doctype": "DocType",
  "name": "Lender Query",
  "module": "DSA Loan Portal",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "is_submittable": 0,
  "autoname": "naming_series:",
  "engine": "InnoDB",
  "track_changes": 1,
  "allow_import": 1,
  "allow_rename": 0,
  "field_order": [
    "naming_series",
    "lender_application",
    "query_subject",
    "query_description",
    "query_category",
    "query_status",
    "assigned_to",
    "raised_on",
    "due_date",
    "response",
    "responded_on",
    "resolution_notes"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "LQ-.YYYY.-.#####",
      "in_list_view": 1
    },
    {
      "fieldname": "lender_application",
      "label": "Lender Application",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "Lender Application",
      "in_list_view": 1
    },
    {
      "fieldname": "query_subject",
      "label": "Query Subject",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "query_description",
      "label": "Query Description",
      "fieldtype": "Text",
      "reqd": 0
    },
    {
      "fieldname": "query_category",
      "label": "Query Category",
      "fieldtype": "Select",
      "reqd": 0,
      "options": "Document\nEligibility\nIncome\nProperty\nClarification\nOther",
      "in_list_view": 1
    },
    {
      "fieldname": "query_status",
      "label": "Query Status",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "Open\nIn Progress\nResponded\nResolved\nClosed",
      "in_list_view": 1
    },
    {
      "fieldname": "assigned_to",
      "label": "Assigned To",
      "fieldtype": "Link",
      "reqd": 0,
      "options": "User",
      "in_list_view": 1
    },
    {
      "fieldname": "raised_on",
      "label": "Raised On",
      "fieldtype": "Datetime",
      "reqd": 0
    },
    {
      "fieldname": "due_date",
      "label": "Due Date",
      "fieldtype": "Date",
      "reqd": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "response",
      "label": "Response",
      "fieldtype": "Text",
      "reqd": 0
    },
    {
      "fieldname": "responded_on",
      "label": "Responded On",
      "fieldtype": "Datetime",
      "reqd": 0
    },
    {
      "fieldname": "resolution_notes",
      "label": "Resolution Notes",
      "fieldtype": "Small Text",
      "reqd": 0
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    }
  ]
}
